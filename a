--══════════════════════════════════════════════════════════════════════════
--  PNG ENCODER  (indexed colour, stored-deflate — no dependencies)
--══════════════════════════════════════════════════════════════════════════
local CRC
local function crc32(s, c, yf)
	if not CRC then
		CRC = {}
		for i = 0, 255 do
			local v = i
			for _ = 1, 8 do
				if band(v, 1) == 1 then v = bxor(rshift(v, 1), 0xEDB88320) else v = rshift(v, 1) end
			end
			CRC[i] = v
		end
	end
	c = c or 0xFFFFFFFF
	local n, cn = #s, 0
	for i = 1, n, 3000 do
		local t = { byte(s, i, min(i + 2999, n)) }
		for k = 1, #t do c = bxor(CRC[band(bxor(c, t[k]), 255)], rshift(c, 8)) end
		cn = cn + 1
		if yf and cn % 24 == 0 then task.wait() end
	end
	return c
end

local function adler32(s, yf)
	local a, b, n, cn = 1, 0, #s, 0
	for i = 1, n, 3800 do
		local t = { byte(s, i, min(i + 3799, n)) }
		for k = 1, #t do a = a + t[k]; b = b + a end
		a, b = a % 65521, b % 65521
		cn = cn + 1
		if yf and cn % 24 == 0 then task.wait() end
	end
	return b * 65536 + a
end

local function be32(n) return char(floor(n / 16777216) % 256, floor(n / 65536) % 256, floor(n / 256) % 256, n % 256) end

local function pngChunk(typ, data, yf)
	local c = crc32(data, crc32(typ), yf)
	return be32(#data) .. typ .. data .. be32(bxor(c, 0xFFFFFFFF))
end

local function zlibStore(raw, yf)
	local out, n, pos = { "\120\1" }, #raw, 1
	while pos <= n do
		local len = min(65535, n - pos + 1)
		local fin = (pos + len > n) and 1 or 0
		out[#out + 1] = char(fin, len % 256, floor(len / 256), (65535 - len) % 256, floor((65535 - len) / 256))
		out[#out + 1] = raw:sub(pos, pos + len - 1)
		pos = pos + len
	end
	out[#out + 1] = be32(adler32(raw, yf))
	return concat(out)
end

local function encodePNG(w, h, palette, raw, yf)
	return "\137PNG\r\n\26\n"
		.. pngChunk("IHDR", be32(w) .. be32(h) .. char(8, 3, 0, 0, 0), yf)
		.. pngChunk("PLTE", palette, yf)
		.. pngChunk("IDAT", zlibStore(raw, yf), yf)
		.. pngChunk("IEND", "", yf)
end

--══════════════════════════════════════════════════════════════════════════
--  CANVAS  (pixel = pal*128 + level ;  pal 0 = foreground ramp, 1 = accent ramp)
--══════════════════════════════════════════════════════════════════════════
local Canvas = {}
Canvas.__index = Canvas

local function newCanvas(w, h)
	local buf = table.create and table.create(w * h, 0) or {}
	if not table.create then for i = 1, w * h do buf[i] = 0 end end
	return setmetatable({ w = w, h = h, buf = buf }, Canvas)
end

local function put(buf, i, pal, lv)
	local e = buf[i]
	if e >= 128 then
		if pal == 1 then
			if lv > e - 128 then buf[i] = 128 + lv end
		elseif lv >= e - 128 then buf[i] = lv end
	else
		if pal == 0 then
			if lv > e then buf[i] = lv end
		elseif lv >= e then buf[i] = 128 + lv end
	end
end

function Canvas:px(x, y, ink, pal)
	if x < 0 or y < 0 or x >= self.w or y >= self.h then return end
	local lv = floor(min(ink, 1) * 127 + 0.5)
	if lv > 0 then put(self.buf, y * self.w + x + 1, pal or 0, lv) end
end

function Canvas:rect(x0, y0, x1, y1, ink, pal)
	local lv = floor(min(ink, 1) * 127 + 0.5)
	if lv <= 0 then return end
	pal = pal or 0
	x0, y0 = max(0, floor(x0)), max(0, floor(y0))
	x1, y1 = min(self.w - 1, floor(x1)), min(self.h - 1, floor(y1))
	local w, buf = self.w, self.buf
	for y = y0, y1 do
		local o = y * w + 1
		for x = x0, x1 do put(buf, o + x, pal, lv) end
	end
end

function Canvas:hline(x0, x1, y, ink, pal, dashed)
	for x = floor(x0), floor(x1) do
		if not dashed or x % 6 < 3 then self:px(x, y, ink, pal) end
	end
end
function Canvas:vline(x, y0, y1, ink, pal, dashed)
	for y = floor(y0), floor(y1) do
		if not dashed or y % 6 < 3 then self:px(x, y, ink, pal) end
	end
end

-- anti-aliased line, thickness in px (continuous coordinates)
function Canvas:line(x0, y0, x1, y1, ink, pal, thick)
	thick = thick or 1
	local steep = abs(y1 - y0) > abs(x1 - x0)
	if steep then x0, y0, x1, y1 = y0, x0, y1, x1 end
	if x0 > x1 then x0, y0, x1, y1 = x1, y1, x0, y0 end
	local dx = x1 - x0
	local g = dx > 1e-9 and (y1 - y0) / dx or 0
	local half = thick / 2
	for x = floor(x0), floor(x1) do
		local cx = clamp(x + 0.5, x0, x1)
		local y = y0 + g * (cx - x0)
		local top, bot = y - half, y + half
		for j = floor(top), floor(bot) do
			local cov = min(j + 1, bot) - max(j, top)
			if cov > 0 then
				if steep then self:px(j, x, cov * ink, pal) else self:px(x, j, cov * ink, pal) end
			end
		end
	end
end

function Canvas:circle(cx, cy, r, ink, pal)
	for y = floor(cy - r - 1), ceil(cy + r + 1) do
		for x = floor(cx - r - 1), ceil(cx + r + 1) do
			local dx, dy = x + 0.5 - cx, y + 0.5 - cy
			local cov = clamp(r + 0.5 - sqrt(dx * dx + dy * dy), 0, 1)
			if cov > 0 then self:px(x, y, cov * ink, pal) end
		end
	end
end

-- gradient area under a polyline (pts = screen coords sorted by x)
function Canvas:area(pts, base, ink, pal)
	local n = #pts
	if n < 2 then return end
	local seg = 1
	for x = ceil(pts[1][1]), floor(pts[n][1]) do
		local cx = max(x + 0.5, pts[1][1])
		while seg < n - 1 and pts[seg + 1][1] < cx do seg = seg + 1 end
		local a, b = pts[seg], pts[seg + 1]
		local dx = b[1] - a[1]
		local y = dx > 0 and (a[2] + (b[2] - a[2]) * clamp((cx - a[1]) / dx, 0, 1)) or b[2]
		local r0 = floor(y)
		local span = max(base - y, 1)
		for r = r0, floor(base) - 1 do
			local f = clamp((r + 0.5 - y) / span, 0, 1)
			local cov = (r == r0) and (1 - (y - r0)) or 1
			self:px(x, r, ink * (1 - f) * cov, pal)
		end
	end
end

function Canvas:text(str, x, y, s, ink, pal, align, bold)
	str = tostring(str):upper()
	s = s or 1
	local w = #str * 6 * s - s
	x, y = floor(x), floor(y)
	if align == "center" then x = x - floor(w / 2) elseif align == "right" then x = x - w end
	for pass = 0, bold and 1 or 0 do
		for i = 1, #str do
			local g = GLYPH[str:sub(i, i)] or GLYPH["?"]
			local gx = x + pass + (i - 1) * 6 * s
			for c = 1, 5 do
				local bits = g[c]
				if bits ~= 0 then
					for r = 0, 6 do
						if band(bits, lshift(1, r)) ~= 0 then
							self:rect(gx + (c - 1) * s, y + r * s, gx + c * s - 1, y + (r + 1) * s - 1, ink, pal)
						end
					end
				end
			end
		end
	end
	return w
end

function Canvas:png(T, yf)
	local br, bg, bb = rgb(T.Background)
	local fr, fg, fb = rgb(T.Foreground)
	local ar, ag, ab = rgb(T.Accent)
	local pal = {}
	for i = 0, 127 do
		local t = i / 127
		pal[#pal + 1] = char(floor(br + (fr - br) * t + 0.5), floor(bg + (fg - bg) * t + 0.5), floor(bb + (fb - bb) * t + 0.5))
	end
	for i = 0, 127 do
		local t = i / 127
		pal[#pal + 1] = char(floor(br + (ar - br) * t + 0.5), floor(bg + (ag - bg) * t + 0.5), floor(bb + (ab - bb) * t + 0.5))
	end
	local w, h, buf, rows = self.w, self.h, self.buf, {}
	for y = 0, h - 1 do
		local o, parts = y * w, { "\0" }
		for x = 1, w, 250 do parts[#parts + 1] = char(unpack(buf, o + x, o + min(x + 249, w))) end
		rows[#rows + 1] = concat(parts)
	end
	return encodePNG(w, h, concat(pal), concat(rows), yf)
end

