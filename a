--  EMBED BUILDER
--══════════════════════════════════════════════════════════════════════════
local Embed = {}
Embed.__index = Embed
local ZWSP = "\226\128\139"

local function newEmbed(client, init)
	local e = setmetatable({ _d = {}, _fields = {}, _files = {}, _c = client }, Embed)
	if client then
		e._d.color = client.Color
		if client.Timestamp ~= false then e._d.timestamp = iso() end
		if client.Footer then e._d.footer = { text = client.Footer, icon_url = client.FooterIcon } end
		if client.Identity ~= false then
			local who = client:_who()
			if who then e._d.author = { name = who.name, icon_url = who.icon } end
		end
	end
	if type(init) == "table" then e:_init(init) end
	return e
end

function Embed:_init(t)
	if t.Title then self:Title(t.Title, t.Url) end
	if t.Url then self:Url(t.Url) end
	if t.Description or t.Text then self:Description(t.Description or t.Text) end
	if t.Color then self:Color(t.Color) end
	if t.Author then
		if type(t.Author) == "table" then self:Author(t.Author[1] or t.Author.Name, t.Author[2] or t.Author.Icon, t.Author.Url)
		else self:Author(t.Author, t.AuthorIcon) end
	end
	if t.Footer then
		if type(t.Footer) == "table" then self:Footer(t.Footer[1] or t.Footer.Text, t.Footer[2] or t.Footer.Icon)
		else self:Footer(t.Footer, t.FooterIcon) end
	end
	if t.Thumbnail then self:Thumbnail(t.Thumbnail) end
	if t.Image then self:Image(t.Image) end
	if t.Fields then self:Fields(t.Fields) end
	if t.Chart then self:Chart(t.Chart) end
	if t.Timestamp ~= nil then self:Timestamp(t.Timestamp) end
end

function Embed:Title(t, url) self._d.title = t ~= nil and tostring(t) or nil; if url then self._d.url = url end; return self end
function Embed:Url(u) self._d.url = u; return self end
function Embed:Description(t) self._d.description = t ~= nil and tostring(t) or nil; return self end
function Embed:Line(t) self._d.description = (self._d.description and (self._d.description .. "\n") or "") .. tostring(t); return self end
Embed.Add = Embed.Line
function Embed:Code(text, lang) return self:Line(Format.Code(text, lang)) end
function Embed:Color(c) self._d.color = toColor(c, self._d.color); return self end
function Embed:Timestamp(v)
	if v == false then self._d.timestamp = nil else self._d.timestamp = iso(type(v) == "number" and v or time()) end
	return self
end
function Embed:Author(name, icon, url)
	self._d.author = name and { name = tostring(name), icon_url = icon, url = url } or nil
	return self
end
function Embed:Footer(text, icon)
	self._d.footer = text and { text = tostring(text), icon_url = icon } or nil
	return self
end
function Embed:Thumbnail(x)
	if type(x) == "table" then return self:Chart(x, true) end
	self._d.thumbnail = x and { url = x } or nil
	return self
end
function Embed:Image(x)
	if type(x) == "table" then return self:Chart(x) end
	self._d.image = x and { url = x } or nil
	return self
end
function Embed:Field(name, value, inline)
	self._fields[#self._fields + 1] = { name = tostring(name), value = tostring(value), inline = inline and true or false }
	return self
end
function Embed:Fields(list)
	for _, f in ipairs(list) do
		local inl = f.Inline
		if inl == nil then inl = f.inline end
		if inl == nil then inl = f[3] end
		self:Field(f.Name or f.name or f[1] or ZWSP, f.Value or f.value or f[2] or ZWSP, inl)
	end
	return self
end
function Embed:Blank(inline) return self:Field(ZWSP, ZWSP, inline) end

-- attach a Chart object as the embed image (or thumbnail)
function Embed:Chart(chart, thumb)
	local url = "attachment://" .. chart:FileName()
	if thumb then self._d.thumbnail = { url = url } else self._d.image = { url = url } end
	self._files[#self._files + 1] = { name = chart:FileName(), chart = chart, mime = "image/png" }
	return self
end
-- attach an arbitrary file (png/jpg can then be referenced as attachment://name)
function Embed:File(name, data, mime)
	self._files[#self._files + 1] = { name = name, data = data, mime = mime or "application/octet-stream" }
	return self
end

function Embed:Build()
	local d = {}
	for k, v in pairs(self._d) do d[k] = v end
	if d.title then d.title = trunc(d.title, 256) end
	if d.description then d.description = trunc(d.description, 4096) end
	if d.footer then d.footer = { text = trunc(d.footer.text, 2048), icon_url = d.footer.icon_url } end
	if d.author then d.author = { name = trunc(d.author.name, 256), icon_url = d.author.icon_url, url = d.author.url } end
	if #self._fields > 0 then
		local f = {}
		for i = 1, min(25, #self._fields) do
			local x = self._fields[i]
			local n, v = trunc(x.name, 256), trunc(x.value, 1024)
			f[i] = { name = n == "" and ZWSP or n, value = v == "" and ZWSP or v, inline = x.inline }
		end
		d.fields = f
	end
	return d
end

function Embed:Send(opts)
	if not self._c then error("Hook: this embed has no client; use Hook:Embed()", 2) end
	return self._c:Send(self, opts)
end

