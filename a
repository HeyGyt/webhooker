local NAMED = {
	red = 0xED4245, green = 0x57F287, blue = 0x3498DB, yellow = 0xFEE75C, orange = 0xE67E22,
	purple = 0x9B59B6, pink = 0xEB459E, cyan = 0x1ABC9C, white = 0xFFFFFF, black = 0x000000,
	gray = 0x95A5A6, grey = 0x95A5A6, gold = 0xF1C40F, blurple = 0x5865F2, dark = 0x2B2D31,
	info = 0x5865F2, success = 0x57F287, warn = 0xFEE75C, error = 0xED4245,
}

-- Color3 | 0xRRGGBB | "#RRGGBB" | "#RGB" | "name" | {r,g,b}  ->  integer
local function toColor(c, def)
	local t = typeof(c)
	if t == "Color3" then
		return floor(c.R * 255 + 0.5) * 65536 + floor(c.G * 255 + 0.5) * 256 + floor(c.B * 255 + 0.5)
	elseif t == "number" then
		return floor(c)
	elseif t == "string" then
		local h = c:match("^#?(%x%x%x%x%x%x)$")
		if h then return tonumber(h, 16) end
		local s = c:match("^#(%x%x%x)$")
		if s then return tonumber(s:gsub(".", "%0%0"), 16) end
		return NAMED[c:lower()] or def
	elseif t == "table" and c[1] then
		return floor(c[1]) * 65536 + floor(c[2] or 0) * 256 + floor(c[3] or 0)
	end
	return def
end
local function rgb(i) return floor(i / 65536) % 256, floor(i / 256) % 256, i % 256 end

local Themes = {
	Mono   = { Background = 0x141414, Foreground = 0xB4B4B4, Accent = 0xFFFFFF },
	Light  = { Background = 0xF2F2F2, Foreground = 0x4A4A4A, Accent = 0x000000 },
	Amber  = { Background = 0x121212, Foreground = 0xB8892B, Accent = 0xFFD166 },
	Matrix = { Background = 0x0B0F0B, Foreground = 0x2E9B4A, Accent = 0x9BFF9B },
	Ice    = { Background = 0x0E1116, Foreground = 0x5B8DB8, Accent = 0xBFE3FF },
	Rose   = { Background = 0x150F12, Foreground = 0xB05C7B, Accent = 0xFFB3CB },
}

local function themeTable(t)
	if type(t) == "string" then return Themes[t] or Themes.Mono end
	return type(t) == "table" and t or nil
end
local function resolveTheme(t, base)
	local r = { Grid = 0.16, Fill = 0.3 }
	for _, src in ipairs({ Themes.Mono, themeTable(base) or {}, themeTable(t) or {} }) do
		for k, v in pairs(src) do r[k] = v end
	end
	r.Background = toColor(r.Background, 0x141414)
	r.Foreground = toColor(r.Foreground, 0xB4B4B4)
	r.Accent = toColor(r.Accent, 0xFFFFFF)
	return r
end

