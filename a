local function trunc(s, n)
	s = tostring(s)
	if utf8 and utf8.len then
		local l = utf8.len(s)
		if l then
			if l <= n then return s end
			local o = utf8.offset(s, n - 2)
			return s:sub(1, (o or n) - 1) .. "..."
		end
	end
	if #s <= n then return s end
	return s:sub(1, n - 3) .. "..."
end

local function splitText(s, n)
	local out = {}
	while #s > n do
		local p = s:sub(1, n):match(".*()\n")
		local chunk, rest
		if p and p > n * 0.4 then chunk, rest = s:sub(1, p - 1), s:sub(p + 1)
		else chunk, rest = s:sub(1, n), s:sub(n + 1) end
		out[#out + 1] = chunk
		s = rest
	end
	out[#out + 1] = s
	return out
end

