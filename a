--  CHART OBJECT
--══════════════════════════════════════════════════════════════════════════
local Chart = {}
Chart.__index = Chart
local chartN = 0
local PAINT = {
	line = paintLine, area = paintLine, spark = paintLine,
	bar = paintBar, hbar = paintHBar, pie = paintPie, donut = paintPie, gauge = paintGauge,
}

local function newChart(kind, o, baseTheme, client)
	kind = tostring(kind or "line"):lower()
	if not PAINT[kind] then error("Hook: unknown chart type '" .. kind .. "' (line, area, spark, bar, hbar, pie, donut, gauge)", 3) end
	o = o or {}
	chartN = chartN + 1
	local self = setmetatable({ Kind = kind, Opts = o, _n = chartN, _c = client }, Chart)
	self.Theme = resolveTheme(o.Theme, baseTheme)
	self.Width = clamp(floor(o.Width or (kind == "spark" and 360 or 640)), 120, 1200)
	self.Height = clamp(floor(o.Height or (kind == "spark" and 90 or (kind == "gauge" and 260 or 320))), 60, 800)
	return self
end

function Chart:FileName() return "chart_" .. self._n .. ".png" end

-- returns PNG bytes (cached). pass true to yield between heavy steps (the sender does)
function Chart:Render(yielding)
	if self._png then return self._png end
	local o = {}
	for k, v in pairs(self.Opts) do o[k] = v end
	if self.Kind == "spark" then
		o.Minimal = true
		if o.Fill == nil then o.Fill = true end
	elseif self.Kind == "area" and o.Fill == nil then
		o.Fill = true
	end
	local cv = newCanvas(self.Width, self.Height)
	PAINT[self.Kind](cv, o, self.Theme, self.Kind)
	self._png = cv:png(self.Theme, yielding)
	return self._png
end
Chart.Png = Chart.Render

function Chart:Send(opts)
	if not self._c then error("Hook: this chart has no client; create it with Hook:Chart(...)", 2) end
	return self._c:Send(self, opts)
end

function Chart:Update(opts)
	for k, v in pairs(opts or {}) do self.Opts[k] = v end
	self._png = nil
	return self
end

