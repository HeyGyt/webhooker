local Format = {}
local SUF = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trim0(s)
	if s:find(".", 1, true) then
		s = (s:gsub("0+$", ""))
		s = (s:gsub("%.$", ""))
	end
	return s
end

-- 1234567 -> "1.23M"
function Format.Number(n, d, space)
	n = tonumber(n) or 0
	d = d or 2
	if n ~= n then return "NaN" end
	if n == math.huge then return "inf" elseif n == -math.huge then return "-inf" end
	local a = abs(n)
	if a < 1000 then
		if n == floor(n) then return fmt("%d", n) end
		return trim0(fmt("%." .. d .. "f", n))
	end
	local i = 0
	while a >= 1000 and i < #SUF do a = a / 1000; i = i + 1 end
	local s = fmt("%." .. d .. "f", a)
	if tonumber(s) >= 1000 and i < #SUF then a = a / 1000; i = i + 1; s = fmt("%." .. d .. "f", a) end
	return (n < 0 and "-" or "") .. trim0(s) .. (space and " " or "") .. SUF[i]
end

function Format.Commas(n)
	local s = fmt("%.0f", abs(tonumber(n) or 0))
	local k
	repeat s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2") until k == 0
	return ((tonumber(n) or 0) < 0 and "-" or "") .. s
end

-- 3661 -> "01:01:01"  |  short: "1h 1m"
function Format.Duration(sec, short)
	sec = floor(max(0, tonumber(sec) or 0))
	local h, m, s = floor(sec / 3600), floor(sec % 3600 / 60), sec % 60
	if short then
		if h > 0 then return fmt("%dh %dm", h, m) end
		if m > 0 then return fmt("%dm %ds", m, s) end
		return s .. "s"
	end
	return fmt("%02d:%02d:%02d", h, m, s)
end

function Format.Percent(v, d) return fmt("%." .. (d or 1) .. "f%%", tonumber(v) or 0) end
function Format.Bar(f, width, a, b)
	width = width or 10
	local n = floor(clamp(f or 0, 0, 1) * width + 0.5)
	return rep(a or "▰", n) .. rep(b or "▱", width - n)
end
function Format.Trend(delta, f)
	f = f or Format.Number
	if delta == 0 or delta ~= delta then return "▬ no change" end
	if delta > 0 then return "▲ +" .. f(delta) end
	return "▼ -" .. f(-delta)
end
function Format.Code(s, lang) return "```" .. (lang or "") .. "\n" .. tostring(s) .. "\n```" end
function Format.Link(text, url) return "[" .. text .. "](" .. url .. ")" end

-- Format.Table({{"a","b"},{"c","d"}}, {"Col1","Col2"}) -> code block
function Format.Table(rows, headers)
	local all, widths = {}, {}
	if headers then all[1] = headers end
	for _, r in ipairs(rows) do all[#all + 1] = r end
	for _, r in ipairs(all) do
		for i, c in ipairs(r) do widths[i] = max(widths[i] or 0, #tostring(c)) end
	end
	local out = {}
	for ri, r in ipairs(all) do
		local cells = {}
		for i = 1, #widths do
			local c = tostring(r[i] or "")
			cells[i] = c .. rep(" ", widths[i] - #c)
		end
		out[#out + 1] = concat(cells, "  ")
		if headers and ri == 1 then
			local ln = {}
			for i = 1, #widths do ln[i] = rep("-", widths[i]) end
			out[#out + 1] = concat(ln, "  ")
		end
	end
	return Format.Code(concat(out, "\n"))
end

