--══════════════════════════════════════════════════════════════════════════
local function niceTicks(lo, hi, n)
	local range = hi - lo
	if range <= 0 then range = max(abs(hi), 1) end
	local rough = range / max(n, 1)
	local mag = 10 ^ floor(math.log10(rough))
	local r = rough / mag
	local step = (r <= 1 and 1 or r <= 2 and 2 or r <= 5 and 5 or 10) * mag
	local t0, t1 = floor(lo / step + 1e-9) * step, ceil(hi / step - 1e-9) * step
	local ticks = {}
	for i = 0, min(30, floor((t1 - t0) / step + 0.5)) do ticks[#ticks + 1] = t0 + i * step end
	return ticks
end

local function normPoints(data)
	local pts = {}
	for i, v in ipairs(data) do
		if type(v) == "number" then
			pts[#pts + 1] = { i, v }
		elseif type(v) == "table" then
			local x, y = v.x or v.t or v[1], v.y or v.v or v[2]
			if x and y then pts[#pts + 1] = { x, y } end
		end
	end
	return pts
end

local function normItems(items)
	local out = {}
	if type(items) ~= "table" then return out end
	if #items > 0 then
		for _, v in ipairs(items) do
			if type(v) == "table" then
				local l = v.Label or v.Name or v.label or v.name or v[1]
				local val = v.Value or v.value or v[2]
				out[#out + 1] = { label = tostring(l), value = tonumber(val) or 0 }
			end
		end
	else
		for k, v in pairs(items) do out[#out + 1] = { label = tostring(k), value = tonumber(v) or 0 } end
		sort(out, function(a, b) return a.value > b.value end)
	end
	return out
end

local SERIES = { { 1, 0 }, { 1, 1 }, { 0.6, 0 }, { 0.6, 1 }, { 0.35, 0 }, { 0.35, 1 } }
local function seriesPaint(i, s)
	local p = SERIES[((i - 1) % #SERIES) + 1]
	return p[1], s.accent and 1 or p[2]
end

local function header(cv, o, ts)
	if o.Title then cv:text(o.Title, 14, 12, ts, 1, 0, "left", true) end
	if o.Subtitle then cv:text(o.Subtitle, cv.w - 14, 12 + 7 * ts - 7, 1, 0.55, 0, "right") end
	return o.Title and (12 + 7 * ts + 16) or 14
end

local function noData(cv, o, T, ts)
	header(cv, o, ts)
	cv:text("NO DATA", cv.w / 2, cv.h / 2 - 3.5 * ts, ts, 0.5, 0, "center")
end

-- ── line / area / spark ────────────────────────────────────────────────
local function paintLine(cv, o, T)
	local w, h = cv.w, cv.h
	local mini = o.Minimal
	local ts = mini and 1 or (o.FontScale or (w >= 480 and 2 or 1))
	local raw = o.Series or { { Name = o.Title, Data = o.Data or {} } }
	local S, total = {}, 0
	local xmin, xmax, ymin, ymax = math.huge, -math.huge, math.huge, -math.huge
	for i, s in ipairs(raw) do
		local pts = normPoints(s.Data or s)
		sort(pts, function(a, b) return a[1] < b[1] end)
		for _, p in ipairs(pts) do
			if p[1] < xmin then xmin = p[1] end
			if p[1] > xmax then xmax = p[1] end
			if p[2] < ymin then ymin = p[2] end
			if p[2] > ymax then ymax = p[2] end
		end
		total = total + #pts
		local fill = o.Fill
		if s.Fill ~= nil then fill = s.Fill end
		S[#S + 1] = { name = s.Name or ("Series " .. i), pts = pts, accent = s.Accent, fill = fill }
	end
	if total == 0 then return noData(cv, o, T, ts) end

	local hh = (not mini or o.Title) and header(cv, o, ts) or 6
	if xmax == xmin then xmin, xmax = xmin - 1, xmax + 1 end
	if o.YMin then ymin = o.YMin elseif o.ZeroBase ~= false and ymin > 0 then ymin = 0 end
	if o.YMax then ymax = o.YMax end
	if ymax <= ymin then ymax = ymin + 1 end
	local ticks
	if mini then
		ticks = { ymin, ymax }
	else
		ticks = niceTicks(ymin, ymax, o.YTicks or (h >= 260 and 5 or 3))
		if not o.YMin then ymin = ticks[1] end
		if not o.YMax then ymax = ticks[#ticks] end
	end
	local yfmt = o.YFormat or num

	local lw = 0
	if not mini then for _, t in ipairs(ticks) do lw = max(lw, #yfmt(t) * 6 * ts) end end
	local x0, x1 = mini and 6 or lw + 16, w - (mini and 6 or 16)
	local y0, y1 = hh, h - (mini and 6 or (7 * ts + 14))
	local dx = xmax - xmin
	local function X(x) return x0 + (x - xmin) / dx * (x1 - x0) end
	local function Y(y) return y1 - (y - ymin) / (ymax - ymin) * (y1 - y0) end

	if not mini then
		for _, t in ipairs(ticks) do
			if t >= ymin and t <= ymax then
				local yy = floor(Y(t))
				cv:hline(x0, x1, yy, T.Grid, 0, true)
				cv:text(yfmt(t), x0 - 8, yy - floor(3.5 * ts), ts, 0.8, 0, "right")
			end
		end
		cv:hline(x0, x1, floor(y1), 0.5, 0)
		local isTime
		if o.XTime ~= nil then isTime = o.XTime else isTime = xmin > 1e9 end
		local tf = o.TimeFormat or (dx > 129600 and "%d/%m %H:%M" or (dx < 600 and "%H:%M:%S" or "%H:%M"))
		local xf = o.XFormat or (isTime and function(v) return dateStr(tf, v) end or num)
		local nx = clamp(floor((x1 - x0) / (#xf(xmax) * 6 * ts + 36)), 2, 6)
		for i = 0, nx do
			local xv = xmin + dx * i / nx
			local lab = xf(xv)
			local px = X(xv)
			local tw = #lab * 6 * ts
			cv:vline(floor(px), y0, y1, T.Grid * 0.7, 0, true)
			cv:text(lab, clamp(px, tw / 2 + 2, w - tw / 2 - 2), y1 + 8, ts, 0.8, 0, "center")
		end
		if #S > 1 then -- legend
			local cur = w - 14
			for i = #S, 1, -1 do
				local nm = trunc(S[i].name, 14)
				local tw = #nm * 6 - 1
				local ink, pal = seriesPaint(i, S[i])
				cv:text(nm, cur - tw, 12 + floor(7 * ts / 2) - 3, 1, 0.85, 0)
				cv:line(cur - tw - 20, 12 + floor(7 * ts / 2), cur - tw - 6, 12 + floor(7 * ts / 2), ink, pal, 2)
				cur = cur - tw - 34
			end
		end
	end

	for i, s in ipairs(S) do
		local pts = s.pts
		local step = max(1, floor(#pts / ((x1 - x0) * 2)))
		local sp = {}
		for k = 1, #pts, step do sp[#sp + 1] = { X(pts[k][1]), Y(pts[k][2]) } end
		local lp = pts[#pts]
		if #pts > 0 and (#sp == 0 or sp[#sp][1] < X(lp[1])) then sp[#sp + 1] = { X(lp[1]), Y(lp[2]) } end
		local ink, pal = seriesPaint(i, s)
		local th = mini and 1.6 or 2
		if s.fill then cv:area(sp, y1, T.Fill * (i == 1 and 1 or 0.6), pal) end
		for k = 1, #sp - 1 do
			cv:line(sp[k][1], sp[k][2], sp[k + 1][1], sp[k + 1][2], ink, pal, th)
			if #sp < 200 then cv:circle(sp[k + 1][1], sp[k + 1][2], th / 2, ink, pal) end
		end
		local last = sp[#sp]
		if last then
			cv:circle(last[1], last[2], mini and 2.5 or 3.5, 1, 1)
			if #S == 1 and not mini and o.ShowLast ~= false then
				local lab = yfmt(lp[2])
				local tw = #lab * 6 * ts
				local ly = last[2] - 7 * ts - 9
				if ly < 2 then ly = last[2] + 9 end
				cv:text(lab, clamp(last[1], tw / 2 + 2, w - tw / 2 - 2), ly, ts, 1, 1, "center", true)
			end
		end
	end
end

-- ── bar (vertical) ─────────────────────────────────────────────────────
local function paintBar(cv, o, T)
	local w, h = cv.w, cv.h
	local ts = o.FontScale or (w >= 480 and 2 or 1)
	local items = normItems(o.Items or o.Data)
	if o.Sort == "desc" then sort(items, function(a, b) return a.value > b.value end)
	elseif o.Sort == "asc" then sort(items, function(a, b) return a.value < b.value end) end
	if o.Limit and #items > o.Limit then for i = #items, o.Limit + 1, -1 do items[i] = nil end end
	if #items == 0 then return noData(cv, o, T, ts) end
	local hh = header(cv, o, ts)
	local vmax, vmin = 0, 0
	local hi = 1
	for i, it in ipairs(items) do
		if it.value > vmax then vmax = it.value; hi = i end
		vmin = min(vmin, it.value)
	end
	if vmax <= 0 then vmax = 1 end
	local ticks = niceTicks(vmin, vmax, o.YTicks or (h >= 260 and 5 or 3))
	local ymin, ymax = ticks[1], ticks[#ticks]
	local yfmt = o.YFormat or num
	local lw = 0
	for _, t in ipairs(ticks) do lw = max(lw, #yfmt(t) * 6 * ts) end
	local x0, x1, y0, y1 = lw + 16, w - 16, hh + 8 * ts, h - (7 * ts + 16)
	local function Y(v) return y1 - (v - ymin) / (ymax - ymin) * (y1 - y0) end
	for _, t in ipairs(ticks) do
		local yy = floor(Y(t))
		cv:hline(x0, x1, yy, T.Grid, 0, true)
		cv:text(yfmt(t), x0 - 8, yy - floor(3.5 * ts), ts, 0.8, 0, "right")
	end
	local zero = floor(Y(0))
	cv:hline(x0, x1, zero, 0.5, 0)
	local n = #items
	local slot = (x1 - x0) / n
	local bw = max(2, floor(slot * 0.68))
	for i, it in ipairs(items) do
		local bx = x0 + (i - 1) * slot + (slot - bw) / 2
		local by = Y(it.value)
		local hot = (o.Highlight ~= false and n > 1 and i == hi)
		local top, bot = min(by, Y(0)), max(by, Y(0))
		cv:rect(bx, top, bx + bw - 1, bot - 1, hot and 0.85 or 0.45, hot and 1 or 0)
		cv:rect(bx, top, bx + bw - 1, top + 1, 1, hot and 1 or 0)
		local lab = yfmt(it.value)
		local s = (#lab * 6 * ts <= slot) and ts or ((#lab * 6 <= slot) and 1 or nil)
		if s then cv:text(lab, bx + bw / 2, top - 7 * s - 4, s, 1, hot and 1 or 0, "center") end
		if n <= 24 or i % ceil(n / 24) == 0 then
			local cl = tostring(it.label)
			local ls = (#cl * 6 * ts <= slot) and ts or 1
			local mc = floor(slot / (6 * ls))
			if #cl > mc then cl = mc >= 2 and (cl:sub(1, mc - 1) .. ".") or cl:sub(1, 1) end
			cv:text(cl, bx + bw / 2, y1 + 8, ls, 0.8, 0, "center")
		end
	end
end

-- ── hbar (horizontal) ──────────────────────────────────────────────────
local function paintHBar(cv, o, T)
	local w, h = cv.w, cv.h
	local ts = o.FontScale or (w >= 480 and 2 or 1)
	local items = normItems(o.Items or o.Data)
	if o.Sort ~= false then sort(items, function(a, b) return a.value > b.value end) end
	if o.Limit and #items > o.Limit then for i = #items, o.Limit + 1, -1 do items[i] = nil end end
	if #items == 0 then return noData(cv, o, T, ts) end
	local hh = header(cv, o, ts)
	local n = #items
	local slot = (h - hh - 12) / n
	if slot < 7 * ts + 6 then ts = 1 end
	local vmax, lw, vw = 0, 0, 0
	local vf = o.YFormat or num
	for _, it in ipairs(items) do
		vmax = max(vmax, it.value)
		lw = max(lw, min(#it.label, 16))
		vw = max(vw, #vf(it.value))
	end
	if vmax <= 0 then vmax = 1 end
	local x0 = lw * 6 * ts + 24
	local x1 = w - 18 - vw * 6 * ts
	local bh = max(3, floor(slot * 0.6))
	cv:vline(floor(x0), hh, h - 8, 0.5, 0)
	for i, it in ipairs(items) do
		local cy = hh + (i - 0.5) * slot
		local len = max(1, it.value / vmax * (x1 - x0))
		local hot = (o.Highlight ~= false and n > 1 and i == 1)
		cv:rect(x0 + 1, cy - bh / 2, x0 + len, cy + bh / 2 - 1, hot and 0.85 or 0.45, hot and 1 or 0)
		cv:rect(x0 + len - 1, cy - bh / 2, x0 + len, cy + bh / 2 - 1, 1, hot and 1 or 0)
		cv:text(trunc(it.label, 16), x0 - 8, cy - 3.5 * ts, ts, 0.85, 0, "right")
		cv:text(vf(it.value), x0 + len + 8, cy - 3.5 * ts, ts, 1, hot and 1 or 0, "left")
	end
end

-- ── pie / donut ────────────────────────────────────────────────────────
local PIE = { 1, 0.78, 0.6, 0.46, 0.35, 0.26, 0.19, 0.13 }
local function paintPie(cv, o, T, kind)
	local w, h = cv.w, cv.h
	local ts = o.FontScale or (w >= 480 and 2 or 1)
	local donut = kind == "donut"
	local all = normItems(o.Items or o.Data)
	local items = {}
	for _, it in ipairs(all) do if it.value > 0 then items[#items + 1] = it end end
	if o.Sort ~= false then sort(items, function(a, b) return a.value > b.value end) end
	local maxn = min(o.Max or 7, 7)
	if #items > maxn then
		local rest = 0
		for i = maxn, #items do rest = rest + items[i].value end
		for i = #items, maxn, -1 do items[i] = nil end
		items[maxn] = { label = "Other", value = rest }
	end
	local total = 0
	for _, it in ipairs(items) do total = total + it.value end
	if total <= 0 then return noData(cv, o, T, ts) end

	local hh = header(cv, o, ts)
	local legend = o.Legend ~= false
	local availH = h - hh - 12
	local r = min(availH / 2, legend and w * 0.34 or (w / 2 - 14))
	local cx = legend and (18 + r) or w / 2
	local cy = hh + availH / 2
	local rin = donut and r * (o.Hole or 0.6) or 0

	local cum, acc = {}, 0
	for i, it in ipairs(items) do acc = acc + it.value / total * 2 * PI; cum[i] = acc end
	local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
	local multi = #items > 1
	for y = floor(cy - r - 1), ceil(cy + r + 1) do
		for x = floor(cx - r - 1), ceil(cx + r + 1) do
			local dx, dy = x + 0.5 - cx, y + 0.5 - cy
			local d = sqrt(dx * dx + dy * dy)
			local cov = clamp(r + 0.5 - d, 0, 1)
			if donut then cov = min(cov, clamp(d - rin + 0.5, 0, 1)) end
			if cov > 0 then
				local a = atan2(dx, -dy)
				if a < 0 then a = a + 2 * PI end
				local k = 1
				while k < #items and a >= cum[k] do k = k + 1 end
				local ink = PIE[k] * cov
				if multi and d > 0 then
					local best = 9
					for b = 0, #items do
						local ang = (b == 0) and 0 or cum[b]
						local da = abs(a - ang)
						if da > PI then da = 2 * PI - da end
						best = min(best, da * d)
					end
					ink = ink * clamp(best / 1.4, 0, 1)
				end
				cv:px(x, y, ink, k == 1 and 1 or 0)
			end
		end
	end
	if donut then
		local ct = o.CenterText or num(total)
		cv:text(ct, cx, cy - 3.5 * (ts + 1) - (o.CenterLabel and 5 or 0), ts + 1, 1, 1, "center", true)
		if o.CenterLabel then cv:text(o.CenterLabel, cx, cy + 7 * ts - 3, 1, 0.6, 0, "center") end
	end
	if legend then
		local lx = cx + r + 28
		local avail = w - 14 - lx
		local s = ts
		if avail < 18 * 6 * s then s = 1 end
		local rowh = 7 * s + 9
		local y = cy - (#items * rowh) / 2 + 2
		local maxc = max(3, floor((avail - 7 * s - 8 - 5 * 6 * s) / (6 * s)))
		for i, it in ipairs(items) do
			cv:rect(lx, y, lx + 7 * s - 1, y + 7 * s - 1, PIE[i], i == 1 and 1 or 0)
			cv:text(trunc(it.label, maxc), lx + 7 * s + 8, y, s, 0.9, 0)
			cv:text(fmt("%d%%", floor(it.value / total * 100 + 0.5)), w - 14, y, s, 1, i == 1 and 1 or 0, "right")
			y = y + rowh
		end
	end
end

-- ── gauge ──────────────────────────────────────────────────────────────
local function paintGauge(cv, o, T)
	local w, h = cv.w, cv.h
	local ts = o.FontScale or (w >= 480 and 2 or 1)
	local vmax = o.Max or 100
	local v = tonumber(o.Value) or 0
	local frac = clamp(v / (vmax > 0 and vmax or 1), 0, 1)
	local hh = header(cv, o, ts)
	local cx, cy = w / 2, h - 12 - 7 * ts - 10
	local r = min((w - 28) / 2, cy - hh - 4)
	local rin = r * 0.74
	local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
	for y = floor(cy - r - 1), ceil(cy) - 1 do
		for x = floor(cx - r - 1), ceil(cx + r + 1) do
			local dx, dy = x + 0.5 - cx, y + 0.5 - cy
			local d = sqrt(dx * dx + dy * dy)
			local cov = min(clamp(r + 0.5 - d, 0, 1), clamp(d - rin + 0.5, 0, 1))
			if cov > 0 and dy < 0 then
				local t = (atan2(dx, -dy) + PI / 2) / PI
				if t <= frac then cv:px(x, y, cov, 1) else cv:px(x, y, cov * 0.16, 0) end
			end
		end
	end
	local txt = o.Text
	if not txt then
		if o.Max == nil or o.Max == 100 then txt = fmt("%d%%", floor(v + 0.5)) else txt = num(v) .. " / " .. num(vmax) end
	end
	cv:text(txt, cx, cy - 7 * (ts + 2) - 6, ts + 2, 1, 1, "center", true)
	local ly = cy + 8
	cv:text("0", cx - (r + rin) / 2, ly, ts, 0.6, 0, "center")
	cv:text(num(vmax), cx + (r + rin) / 2, ly, ts, 0.6, 0, "center")
	if o.Label then cv:text(o.Label, cx, ly, ts, 0.9, 0, "center") end
end

