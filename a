--  TRANSPORT
--══════════════════════════════════════════════════════════════════════════
local function findRequester()
	local env = (getgenv and getgenv()) or _G
	local c = {
		env.request, env.http_request,
		env.syn and env.syn.request,
		env.http and env.http.request,
		env.fluxus and env.fluxus.request,
	}
	for i = 1, 5 do if type(c[i]) == "function" then return c[i] end end
end

local function lowerKeys(t)
	local o = {}
	for k, v in pairs(t or {}) do o[tostring(k):lower()] = v end
	return o
end

local function transport(req)
	local r = findRequester()
	if r then
		local res = r({ Url = req.Url, Method = req.Method, Headers = req.Headers, Body = req.Body })
		return tonumber(res.StatusCode or res.Status) or 0, lowerKeys(res.Headers), res.Body or ""
	end
	if HttpService and HttpService.RequestAsync then
		local res = HttpService:RequestAsync({ Url = req.Url, Method = req.Method, Headers = req.Headers, Body = req.Body })
		return tonumber(res.StatusCode) or 0, lowerKeys(res.Headers), res.Body or ""
	end
	error("no HTTP function available (executor `request` / HttpService)")
end

local function multipart(json, files)
	local b = "----HookBoundary" .. math.random(100000, 999999) .. math.random(100000, 999999)
	local p = { "--" .. b .. '\r\nContent-Disposition: form-data; name="payload_json"\r\nContent-Type: application/json\r\n\r\n' .. json .. "\r\n" }
	for i, f in ipairs(files) do
		p[#p + 1] = "--" .. b .. '\r\nContent-Disposition: form-data; name="files[' .. (i - 1) .. ']"; filename="' .. f.name .. '"\r\nContent-Type: ' .. (f.mime or "application/octet-stream") .. "\r\n\r\n"
		p[#p + 1] = f.data
		p[#p + 1] = "\r\n"
	end
	p[#p + 1] = "--" .. b .. "--\r\n"
	return concat(p), "multipart/form-data; boundary=" .. b
end

local MIME = { png = "image/png", jpg = "image/jpeg", jpeg = "image/jpeg", gif = "image/gif", txt = "text/plain", log = "text/plain", json = "application/json", csv = "text/csv" }

