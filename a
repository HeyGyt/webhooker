function Client:Configure(cfg)
	for k, v in pairs(cfg or {}) do
		if k == "Webhook" or k == "Url" then self:SetUrl(v)
		elseif k == "Color" then self.Color = toColor(v, self.Color)
		elseif k == "Ping" then self:SetPing(v)
		else self[k] = v end
	end
	return self
end

function Client:SetUrl(url)
	url = tostring(url or ""):match("^%s*(.-)%s*$")
	url = url:gsub("discordapp%.com", "discord.com")
	self.Url = url
	return self
end

-- SetPing{ User = "id"|{ids}, Role = "id"|{ids}, Everyone = bool, Here = bool }  — used by Ping = true
function Client:SetPing(t)
	if type(t) == "string" or type(t) == "number" then t = { User = tostring(t) } end
	self.PingTargets = t or {}
	return self
end

local function newClient(url, cfg)
	local self = setmetatable({
		Color = 0x5865F2, Theme = "Mono", Timestamp = true, Identity = true,
		Retries = 3, Interval = 0.35, MaxQueue = 200, LogInterval = 8, Debug = false,
		PingTargets = {}, PingOn = { error = true },
		_q = {}, _cool = {}, _logs = {}, _t0 = time(),
	}, Client)
	if type(url) == "table" then cfg, url = url, nil end
	if url then self:SetUrl(url) end
	if cfg then self:Configure(cfg) end
	return self
end

function Client:_who()
