-- ── message composition ────────────────────────────────────────────────
local function pingText(self, ping)
	if ping == true then ping = self.PingTargets end
	if not ping then return "" end
	if type(ping) == "string" or type(ping) == "number" then
		ping = tostring(ping)
		return ping:match("^%d+$") and Mention.User(ping) or ping
	end
	local out = {}
	local function add(v, f)
		if v == nil then return end
		if type(v) == "table" then for _, x in ipairs(v) do out[#out + 1] = f(x) end else out[#out + 1] = f(v) end
	end
	add(ping.User or ping.Users, Mention.User)
	add(ping.Role or ping.Roles, Mention.Role)
	if ping.Everyone then out[#out + 1] = "@everyone" end
	if ping.Here then out[#out + 1] = "@here" end
	return concat(out, " ")
end

local function allowedMentions(content)
	local am = { parse = {} }
	if content then
		local users, roles = {}, {}
		for id in content:gmatch("<@!?(%d+)>") do users[#users + 1] = id end
		for id in content:gmatch("<@&(%d+)>") do roles[#roles + 1] = id end
		if #users > 0 then am.users = users end
		if #roles > 0 then am.roles = roles end
		if content:find("@everyone", 1, true) or content:find("@here", 1, true) then am.parse = { "everyone" } end
	end
	return am
end

local MSG_KEYS = { "Content", "Embed", "Embeds", "Files", "Chart", "Charts", "Username", "Avatar", "Ping", "Silent", "Tts", "ThreadName" }
local EMBED_KEYS = { "Title", "Description", "Fields", "Image", "Thumbnail", "Footer", "Author", "Text" }
local function hasAny(t, keys) for _, k in ipairs(keys) do if t[k] ~= nil then return true end end return false end

function Client:_compose(a, o)
	local embeds, content, opt = {}, nil, o or {}
	local function addEmbed(e)
		local mt = getmetatable(e)
		if mt == Embed then embeds[#embeds + 1] = e
		elseif mt == Chart then embeds[#embeds + 1] = self:Embed():Chart(e)
		elseif type(e) == "table" then embeds[#embeds + 1] = self:Embed(e) end
	end
	local ta = type(a)
	if ta == "string" or ta == "number" then
		content = tostring(a)
	elseif ta == "table" then
		local mt = getmetatable(a)
		if mt == Embed or mt == Chart then
			addEmbed(a)
		elseif hasAny(a, MSG_KEYS) then
			opt = a
			content = a.Content and tostring(a.Content) or nil
			if a.Embed then addEmbed(a.Embed) end
			for _, e in ipairs(a.Embeds or {}) do addEmbed(e) end
			if a.Chart then addEmbed(a.Chart) end
			for _, c in ipairs(a.Charts or {}) do addEmbed(c) end
		elseif hasAny(a, EMBED_KEYS) then
			addEmbed(a)
		else
			for _, e in ipairs(a) do addEmbed(e) end
		end
	end

	local ping = pingText(self, opt.Ping)
	if ping ~= "" then content = ping .. (content and (" " .. content) or "") end

	local function build(text, group, files)
		local p = {
			content = text,
			username = opt.Username or self.Username,
			avatar_url = opt.Avatar or self.Avatar,
			tts = opt.Tts,
			thread_name = opt.ThreadName,
			flags = opt.Silent and 4096 or nil,
			allowed_mentions = (self.SafeMentions ~= false) and allowedMentions(text) or nil,
		}
		if group then
			p.embeds = {}
			for i, e in ipairs(group) do
				p.embeds[i] = e:Build()
				for _, f in ipairs(e._files) do files[#files + 1] = f end
			end
		end
		return { payload = p, files = files }
	end

	local msgs = {}
	local chunks = content and splitText(content, 2000) or {}
	local groups = {}
	for i = 1, #embeds, 10 do groups[#groups + 1] = { unpack(embeds, i, min(i + 9, #embeds)) } end
	for i = 1, #chunks - 1 do msgs[#msgs + 1] = build(chunks[i]) end
	if #chunks >= 1 or #groups >= 1 then
		msgs[#msgs + 1] = build(chunks[#chunks], groups[1], {})
	end
	for i = 2, #groups do msgs[#msgs + 1] = build(nil, groups[i], {}) end

	if opt.Files and #opt.Files > 0 then
		if #msgs == 0 then msgs[1] = build(nil, nil, {}) end
		local target = msgs[#msgs]
		for _, f in ipairs(opt.Files) do
			local name = f.Name or f.name or "file.txt"
			local ext = name:match("%.(%w+)$")
			target.files[#target.files + 1] = {
				name = name, data = f.Data or f.data or "",
				mime = f.Mime or f.mime or MIME[(ext or ""):lower()] or "application/octet-stream",
			}
		end
	end
	if #msgs == 0 then error("Hook: nothing to send (empty message)", 3) end
	return msgs
end

-- ── queue / sender ─────────────────────────────────────────────────────
function Client:_enqueue(job)
	if type(self.Url) ~= "string" or self.Url == "" then
		error("Hook: webhook URL not set — call Hook:SetUrl(\"https://discord.com/api/webhooks/...\")", 3)
	end
	if #self._q >= self.MaxQueue then
		warn("[Hook] queue full, dropping message")
		return setmetatable({ Done = true, Ok = false, Error = "queue full", _c = self }, Handle)
	end
	job.handle = setmetatable({ Done = false, Ok = false, _c = self }, Handle)
	self._q[#self._q + 1] = job
	if not self._running then
		self._running = true
		task.spawn(function()
			while #self._q > 0 do
				local j = remove(self._q, 1)
				local ok, err = pcall(self._exec, self, j)
				if not ok then
					j.handle.Done, j.handle.Ok, j.handle.Error = true, false, tostring(err)
					warn("[Hook] " .. tostring(err))
				end
			end
			self._running = false
		end)
	end
	return job.handle
end

function Client:_target(job)
	local base = self.Url
	local path, query = base:match("^([^?]*)%??(.*)$")
	path = path:gsub("/+$", "")
	local q = {}
	if query ~= "" then q[#q + 1] = query end
	if self.Thread then q[#q + 1] = "thread_id=" .. tostring(self.Thread) end
	if job.method == "POST" and not job.plain then q[#q + 1] = "wait=true" end
	if job.method ~= "POST" then
		local t = job.target
		local id = type(t) == "table" and t.Id or t
		if not id then error("message id unknown (original send failed or still pending)") end
		path = path .. "/messages/" .. tostring(id)
	end
	return path .. (#q > 0 and ("?" .. concat(q, "&")) or "")
end

function Client:_exec(job)
	local h = job.handle
	local function fail(err)
		h.Done, h.Ok, h.Error = true, false, tostring(err)
		warn("[Hook] send failed: " .. tostring(err))
		if self.OnError then pcall(self.OnError, tostring(err)) end
	end

	-- build the request once (charts render here, yielding between heavy steps)
	local built, url, headers, data = pcall(function()
		local u = self:_target(job)
		local hd, body = { ["Content-Type"] = "application/json" }, nil
		if job.method ~= "DELETE" then
			local files = job.files
			if files and #files > 0 then
				for _, f in ipairs(files) do
					if not f.data and f.chart then f.data = f.chart:Render(true) end
				end
				body, hd["Content-Type"] = multipart(jenc(job.payload), files)
			else
				body = jenc(job.payload)
			end
		end
		return u, hd, body
	end)
	if not built then return fail(url) end

	local tries, rl, lastErr = 0, 0, nil
	while true do
		local gap = self._gate and (self._gate - clock()) or 0
		if gap > 0 then task.wait(gap) end
		tries = tries + 1
		local ok, status, hdr, body = pcall(transport, { Url = url, Method = job.method, Headers = headers, Body = data })
		if not ok then
			lastErr = tostring(status)
			if tries > self.Retries then break end
			task.wait(0.5 * 2 ^ tries)
		else
			self._gate = clock() + self.Interval
			if hdr["x-ratelimit-remaining"] == "0" and tonumber(hdr["x-ratelimit-reset-after"]) then
				self._gate = max(self._gate, clock() + tonumber(hdr["x-ratelimit-reset-after"]) + 0.05)
			end
			if status >= 200 and status < 300 then
				local d = body ~= "" and jdec(body) or nil
				if type(d) == "table" and d.id then h.Id, h.Data = d.id, d end
				if not h.Id and job.target then h.Id = type(job.target) == "table" and job.target.Id or job.target end
				h.Ok, h.Done = true, true
				if self.Debug then print("[Hook] sent (" .. status .. ")") end
				return
			elseif status == 429 then
				local d = jdec(body)
				local ra = (type(d) == "table" and tonumber(d.retry_after)) or tonumber(hdr["retry-after"]) or 2
				self._gate = clock() + ra + 0.1
				tries = tries - 1
				rl = rl + 1
				lastErr = "rate limited"
				if rl > 8 then break end
			elseif status >= 500 or status == 0 then
				lastErr = "HTTP " .. status
				if tries > self.Retries then break end
				task.wait(0.5 * 2 ^ tries)
			else
				lastErr = "HTTP " .. status .. ": " .. trunc(body, 300)
				break
			end
		end
	end
	fail(lastErr)
end

-- ── public sending API ─────────────────────────────────────────────────
-- Send("text" | Embed | Chart | {embeds} | {Content=,Embeds=,Files=,Ping=,Silent=,...}, opts?)
function Client:Send(a, o)
	local msgs = self:_compose(a, o)
	local h
	for _, m in ipairs(msgs) do h = self:_enqueue({ method = "POST", payload = m.payload, files = m.files }) end
	return h
end

function Client:Edit(target, a, o)
	local msgs = self:_compose(a, o)
	local m = msgs[#msgs]
	local p = m.payload
	p.username, p.avatar_url, p.thread_name, p.flags = nil, nil, nil, nil
	p.content = p.content or ""
	p.attachments = {}
	return self:_enqueue({ method = "PATCH", payload = p, files = m.files, target = target })
end

function Client:Delete(target) return self:_enqueue({ method = "DELETE", target = target }) end

-- post arbitrary JSON (Slack / Guilded / custom webhooks) — no Discord-specific query params
function Client:Raw(tbl) return self:_enqueue({ method = "POST", payload = tbl, plain = true }) end

function Client:SendFile(name, data, content, opts)
	opts = opts or {}
	return self:Send({ Content = content, Files = { { Name = name, Data = data } }, Ping = opts.Ping, Silent = opts.Silent })
end

-- block until everything queued has been sent (use before teleporting / leaving)
function Client:Flush(timeout)
	local t0 = clock()
	while (#self._q > 0 or self._running) and (not timeout or clock() - t0 < timeout) do task.wait(0.05) end
end

-- ── notifications ──────────────────────────────────────────────────────
local LEVELS = {
	info = { 0x5865F2, "ℹ️" }, success = { 0x57F287, "✅" }, warn = { 0xFEE75C, "⚠️" },
	error = { 0xED4245, "🚨" }, debug = { 0x95A5A6, "🐞" },
}

function Client:Context()
	local c = {}
	pcall(function()
		local lp = Players.LocalPlayer
		c.Player, c.DisplayName, c.UserId, c.AccountAge = lp.Name, lp.DisplayName, lp.UserId, lp.AccountAge
		c.Avatar = fmt(HEADSHOT, lp.UserId)
	end)
	pcall(function()
		c.PlaceId, c.JobId = game.PlaceId, game.JobId
		c.Players, c.MaxPlayers = #Players:GetPlayers(), Players.MaxPlayers
		c.Join = fmt("https://www.roblox.com/games/start?placeId=%d&gameInstanceId=%s", game.PlaceId, game.JobId)
	end)
	pcall(function() c.Ping = floor(service("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end)
	pcall(function() c.Memory = floor(service("Stats"):GetTotalMemoryUsageMb()) end)
	startFps()
	c.FPS = floor(fpsAvg or 0)
	c.GameName = gameName()
	c.Uptime = time() - self._t0
	return c
end

local function contextFields(c)
	return {
		{ "Player", fmt("%s\n`@%s`", c.DisplayName or "?", c.Player or "?"), true },
		{ "Game", trunc(c.GameName or "?", 60), true },
		{ "Server", fmt("%s/%s players\n`%s`", c.Players or "?", c.MaxPlayers or "?", (c.JobId or ""):sub(1, 8)), true },
		{ "Performance", fmt("%s FPS · %s ms\n%s MB", c.FPS or "?", c.Ping or "?", c.Memory or "?"), true },
		{ "Uptime", Format.Duration(c.Uptime or 0, true), true },
		{ "Join", c.Join and Format.Link("Join server", c.Join) or "?", true },
	}
end

-- Notify(level, title, description?, { Fields, Chart, Ping, Silent, Color, Icon, Thumbnail, Context, Cooldown, Key })
function Client:Notify(level, title, desc, o)
	o = o or {}
	local L = LEVELS[level] or LEVELS.info
	if o.Cooldown then
		local key, t = o.Key or (level .. ":" .. tostring(title)), clock()
		if self._cool[key] and t - self._cool[key] < o.Cooldown then return nil end
		self._cool[key] = t
	end
	local e = self:Embed():Color(o.Color or L[1]):Title((o.Icon or L[2]) .. " " .. tostring(title))
	if desc then e:Description(desc) end
	if o.Fields then e:Fields(o.Fields) end
	if o.Context then
		local c = self:Context()
		e:Fields(contextFields(c))
		if c.Avatar and not o.Thumbnail then e:Thumbnail(c.Avatar) end
	end
	if o.Thumbnail then e:Thumbnail(o.Thumbnail) end
	if o.Chart then e:Chart(o.Chart) end
	local ping = o.Ping
	if ping == nil and self.PingOn[level] then ping = true end
	return self:Send(e, { Ping = ping, Silent = o.Silent, Username = o.Username })
end
for lvl in pairs(LEVELS) do
	Client[lvl:sub(1, 1):upper() .. lvl:sub(2)] = function(self, title, desc, o) return self:Notify(lvl, title, desc, o) end
end

function Client:Status(o)
	o = o or {}
	local c = self:Context()
	local e = self:Embed():Title(o.Title or "📡 Status"):Color(o.Color or 0x57F287):Fields(contextFields(c))
	if c.Avatar then e:Thumbnail(c.Avatar) end
	if o.Chart then e:Chart(o.Chart) end
	return self:Send(e, o)
end

function Client:Test()
	return self:Success("Hook connected", "Webhook is working.\nHook `v" .. VERSION .. "` · " .. Mention.Time(time(), "T"), { Context = true })
end

-- ── scheduling ─────────────────────────────────────────────────────────
function Client:Every(seconds, fn)
	local alive = true
	task.spawn(function()
		while alive do
			task.wait(seconds)
			if not alive then break end
			local ok, err = pcall(fn)
			if not ok then warn("[Hook] Every(): " .. tostring(err)) end
		end
	end)
	return { Stop = function() alive = false end }
end

function Client:Heartbeat(seconds, o) return self:Every(seconds, function() self:Status(o) end) end

-- one message that is created once, then edited every `seconds`. builder() -> (message, opts)
function Client:Live(seconds, builder)
	local handle
	local alive = true
	local function tick()
		local ok, msg, o = pcall(builder)
		if not ok then warn("[Hook] Live(): " .. tostring(msg)); return end
		if not msg then return end
		if handle and (not handle.Done or handle.Id) then self:Edit(handle, msg, o) else handle = self:Send(msg, o) end
	end
	task.spawn(function()
		tick()
		while alive do
			task.wait(seconds)
			if alive then tick() end
		end
	end)
	return { Stop = function() alive = false end, Update = tick, Message = function() return handle end }
end

-- ── buffered logger ────────────────────────────────────────────────────
function Client:FlushLogs()
	if #self._logs == 0 then return end
	local t = concat(self._logs, "\n")
	self._logs = {}
	return self:Send(Format.Code(t))
end
function Client:Log(...)
	local p = {}
	for i = 1, select("#", ...) do p[i] = tostring((select(i, ...))) end
	local buf = self._logs
	buf[#buf + 1] = trunc(os.date("%H:%M:%S") .. "  " .. concat(p, " "), 400)
	local size = 0
	for _, l in ipairs(buf) do size = size + #l + 1 end
	if size > 1700 then
		self:FlushLogs()
	elseif not self._logT then
		self._logT = true
		task.delay(self.LogInterval, function() self._logT = false; self:FlushLogs() end)
	end
end

-- ── watchers ───────────────────────────────────────────────────────────
function Client:WatchDisconnect(o)
	o = o or {}
	local conns, last = {}, -100
	local function fire(reason)
		if clock() - last < 15 then return end
		last = clock()
		self:Error("Disconnected", reason or "Connection lost", { Ping = o.Ping ~= false, Context = true })
		if o.OnDisconnect then pcall(o.OnDisconnect, reason) end
	end
	local gui = service("GuiService")
	if gui then
		conns[#conns + 1] = gui.ErrorMessageChanged:Connect(function(msg) if msg and msg ~= "" then fire(msg) end end)
	end
	pcall(function()
		local overlay = service("CoreGui").RobloxPromptGui.promptOverlay
		conns[#conns + 1] = overlay.ChildAdded:Connect(function(ch)
			if ch.Name == "ErrorPrompt" then
				local msg = "Roblox error prompt"
				pcall(function() msg = ch.MessageArea.ErrorFrame.ErrorMessage.Text end)
				fire(msg)
			end
		end)
	end)
	return { Stop = function() for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end end }
end

-- WatchPlayers{ Only = {"name"|userId,...}, Join = true, Leave = true, Existing = false, Ping = false, Level = "info" }
function Client:WatchPlayers(o)
	o = o or {}
	local only
	if o.Only then
		only = {}
		for _, n in ipairs(o.Only) do only[tostring(n):lower()] = true end
	end
	local lp = Players.LocalPlayer
	local function want(p)
		if p == lp then return false end
		if only then return only[p.Name:lower()] or only[p.DisplayName:lower()] or only[tostring(p.UserId)] or false end
		return true
	end
	local function announce(p, verb)
		self:Notify(o.Level or "info", "Player " .. verb,
			fmt("[%s](https://www.roblox.com/users/%d/profile) (`@%s`)", p.DisplayName, p.UserId, p.Name),
			{ Thumbnail = fmt(HEADSHOT, p.UserId), Ping = o.Ping })
	end
	local conns = {}
	if o.Join ~= false then
		conns[#conns + 1] = Players.PlayerAdded:Connect(function(p) if want(p) then announce(p, "joined") end end)
	end
	if o.Leave ~= false then
		conns[#conns + 1] = Players.PlayerRemoving:Connect(function(p) if want(p) then announce(p, "left") end end)
	end
	if o.Existing then for _, p in ipairs(Players:GetPlayers()) do if want(p) then announce(p, "is here") end end end
	return { Stop = function() for _, c in ipairs(conns) do c:Disconnect() end end }
end

--══════════════════════════════════════════════════════════════════════════
--  STATS  (session tracking · rates · history · charts · reports)
--══════════════════════════════════════════════════════════════════════════
local Stats = {}
Stats.__index = Stats

function Client:Stats(o)
	o = o or {}
	return setmetatable({
		_c = self, Title = o.Title or "Session Stats", Color = o.Color, Compact = o.Compact, Theme = o.Theme,
		Items = {}, Order = {}, SampleEvery = o.SampleEvery or 15, MaxSamples = o.MaxSamples or 240,
		StartTime = time(), _ms = {}, _stall = {},
	}, Stats)
end

local function itemFmt(it, v)
	local f = it.Fmt
	if type(f) == "function" then return f(v) end
	if f == "time" then return Format.Duration(v) end
	if f == "percent" then return Format.Percent(v) end
	if f == "commas" then return Format.Commas(v) end
	return num(v, it.Decimals or 2) .. (it.Unit and (" " .. it.Unit) or "")
end

local function restore(it, p)
	if type(p) ~= "table" then return end
	it.start, it.t0 = p.s, p.t0
	if not it.get and p.v then it.value = p.v end
	if type(p.h) == "table" then
		for i = 1, #p.h - 1, 2 do it.hist[#it.hist + 1] = { p.h[i], p.h[i + 1] } end
	end
end

function Stats:_item(name)
	local it = self.Items[name]
	if not it then
		it = { Name = name, hist = {}, lastChange = clock(), t0 = time() }
		self.Items[name] = it
		self.Order[#self.Order + 1] = name
		if self._pst and self._pst[name] then restore(it, self._pst[name]) end
		self:Start()
	end
	return it
end

function Stats:_apply(it, v)
	if it.value ~= v then it.lastChange = clock() end
	if it.start == nil then it.start = v end
	it.value = v
	local ms = self._ms[it.Name]
	if ms then
		local k = floor(v / ms.step)
		if ms.last == nil then ms.last = k
		elseif k > ms.last then
			ms.last = k
			self._c:Success("Milestone: " .. it.Name,
				fmt("**%s** reached `%s`", it.Name, itemFmt(it, k * ms.step)),
				{ Ping = ms.Ping, Chart = ms.Chart, Context = ms.Context })
		end
	end
end

function Stats:_read(it)
	if it.get then
		local ok, v = pcall(it.get)
		if ok and type(v) == "number" then self:_apply(it, v) end
	end
end

-- Track("Coins", Value | function | number, { Icon, Unit, Format = fn|"time"|"percent"|"commas", Decimals, Hidden })
function Stats:Track(name, src, o)
	o = o or {}
	local it = self:_item(name)
	if typeof(src) == "Instance" then
		local inst = src
		it.get = function() return inst.Value end
	elseif type(src) == "function" then
		it.get = src
	elseif type(src) == "number" then
		self:_apply(it, src)
	end
	it.Icon, it.Unit, it.Fmt, it.Hidden, it.Decimals = o.Icon, o.Unit, o.Format, o.Hidden, o.Decimals
	self:_read(it)
	return self
end

function Stats:Set(name, v) self:_apply(self:_item(name), v); return self end
function Stats:Add(name, n)
	local it = self:_item(name)
	self:_apply(it, (it.value or 0) + (n or 1))
	return self
end
function Stats:Get(name) local it = self.Items[name]; return it and it.value or 0 end
function Stats:Gain(name)
	local it = self.Items[name]
	return (it and it.value and it.start) and (it.value - it.start) or 0
end
function Stats:Elapsed() return time() - self.StartTime end
-- per: "sec" | "min" | "hour" (default) | "day"
function Stats:Rate(name, per)
	local it = self.Items[name]
	if not it then return 0 end
	local el = max(time() - (it.t0 or self.StartTime), 1)
	return self:Gain(name) / el * (({ sec = 1, min = 60, hour = 3600, day = 86400 })[per or "hour"] or 3600)
end

function Stats:Milestone(name, step, o)
	o = o or {}
	self._ms[name] = { step = step, Ping = o.Ping, Chart = o.Chart, Context = o.Context }
	self:_item(name)
	return self
end
function Stats:Stall(name, seconds, o)
	o = o or {}
	self._stall[name] = { after = seconds, Ping = o.Ping, Recover = o.Recover ~= false }
	self:_item(name)
	return self
end

function Stats:Sample()
	local t = time()
	for _, name in ipairs(self.Order) do
		local it = self.Items[name]
		self:_read(it)
		if it.value ~= nil then
			local h = it.hist
			h[#h + 1] = { t, it.value }
			if #h > self.MaxSamples then
				local nh = {}
				for i = 1, #h, 2 do nh[#nh + 1] = h[i] end
				if nh[#nh] ~= h[#h] then nh[#nh + 1] = h[#h] end
				it.hist = nh
			end
		end
		local st = self._stall[name]
		if st then
			local idle = clock() - it.lastChange
			if idle >= st.after and not st.fired then
				st.fired = true
				self._c:Warn(name .. " stalled", fmt("No change in **%s** for `%s`.", name, Format.Duration(idle, true)), { Ping = st.Ping, Context = true })
			elseif idle < st.after and st.fired then
				st.fired = false
				if st.Recover then self._c:Success(name .. " recovered", "Changing again.") end
			end
		end
	end
	self:_save()
end

function Stats:Start()
	if self._loop then return self end
	local alive = true
	self._loop = { Stop = function() alive = false; self._loop = nil end }
	task.spawn(function()
		while alive do
			task.wait(self.SampleEvery)
			if alive then
				local ok, err = pcall(self.Sample, self)
				if not ok then warn("[Hook] Stats sample: " .. tostring(err)) end
			end
		end
	end)
	return self
end
function Stats:Stop()
	if self._loop then self._loop.Stop() end
	if self._auto then self._auto.Stop() end
	if self._live then self._live.Stop() end
end

function Stats:Reset()
	self.StartTime = time()
	for _, it in pairs(self.Items) do it.start, it.t0, it.hist, it.reported = it.value, time(), {}, nil end
	self:_save()
end

function Stats:Persist(file, o)
	o = o or {}
	self._file = file
	if not (isfile and readfile and writefile) then return self end
	local ok, d = pcall(function() if isfile(file) then return jdec(readfile(file)) end end)
	if ok and type(d) == "table" and d.t0 and (time() - d.t0) < (o.Expire or 43200) then
		self.StartTime = d.t0
		self._pst = d.items or {}
		for name, p in pairs(self._pst) do
			local it = self.Items[name]
			if it then it.hist = {}; restore(it, p) end
		end
	end
	return self
end

function Stats:_save()
	if not self._file or not writefile then return end
	pcall(function()
		local items = {}
		for name, it in pairs(self.Items) do
			local h = {}
			for _, p in ipairs(it.hist) do h[#h + 1] = p[1]; h[#h + 1] = p[2] end
			items[name] = { s = it.start, v = it.value, t0 = it.t0, h = h }
		end
		writefile(self._file, jenc({ t0 = self.StartTime, items = items }))
	end)
end

-- history series for charts. mode: "value" | "gain" | "rate" (per `per`, default hour)
function Stats:_hist(it, mode, per)
	local out = {}
	local pm = ({ sec = 1, min = 60, hour = 3600, day = 86400 })[per or "hour"] or 3600
	local h = it.hist
	if mode == "rate" then
		for i = 2, #h do
			local dt = max(h[i][1] - h[i - 1][1], 1)
			out[#out + 1] = { h[i][1], (h[i][2] - h[i - 1][2]) / dt * pm }
		end
	elseif mode == "gain" then
		for _, p in ipairs(h) do out[#out + 1] = { p[1], p[2] - (it.start or 0) } end
	else
		for _, p in ipairs(h) do out[#out + 1] = { p[1], p[2] } end
	end
	return out
end

function Stats:_val(it, mode, per)
	if mode == "rate" then return self:Rate(it.Name, per) end
	if mode == "gain" then return self:Gain(it.Name) end
	return it.value or 0
end

-- Chart("Coins" | {"Coins","Gems"}, { Type = "area"|"line"|"spark"|"bar"|"hbar"|"pie"|"donut"|"gauge", Mode = "value"|"gain"|"rate", Per = "hour", Title, Theme, Width, Height, ... })
function Stats:Chart(names, o)
	o = o or {}
	if type(names) == "string" then names = { names } end
	names = names or self.Order
	local kind = tostring(o.Type or "area"):lower()
	local mode, per = o.Mode or "value", o.Per or "hour"
	local co = {}
	for k, v in pairs(o) do co[k] = v end
	co.Theme = co.Theme or self.Theme
	if kind == "line" or kind == "area" or kind == "spark" then
		local series = {}
		for _, n in ipairs(names) do
			local it = self.Items[n]
			if it then series[#series + 1] = { Name = n, Data = self:_hist(it, mode, per) } end
		end
		co.Series, co.XTime = series, true
		if #names == 1 then co.Title = co.Title or names[1] end
		co.YFormat = co.YFormat or (self.Items[names[1]] and self.Items[names[1]].Fmt == "percent" and function(v) return fmt("%d%%", v) end) or nil
		co.Subtitle = co.Subtitle or (mode == "rate" and ("PER " .. per) or (mode == "gain" and "SESSION GAIN" or nil))
	elseif kind == "gauge" then
		local it = self.Items[names[1]]
		co.Value = it and self:_val(it, mode, per) or 0
		co.Label = co.Label or names[1]
	else
		local items = {}
		for _, n in ipairs(names) do
			local it = self.Items[n]
			if it then items[#items + 1] = { n, self:_val(it, mode, per) } end
		end
		co.Items = items
		co.Subtitle = co.Subtitle or (mode == "rate" and ("PER " .. per) or (mode == "gain" and "SESSION GAIN" or nil))
	end
	return self._c:Chart(kind, co)
end

function Stats:Embed(o)
	o = o or {}
	local e = self._c:Embed():Title(o.Title or self.Title)
	if o.Color or self.Color then e:Color(o.Color or self.Color) end
	e:Description(fmt("⏱ Session **%s**  ·  Updated %s", Format.Duration(self:Elapsed()), Mention.Time(time(), "R")))
	local compact = o.Compact
	if compact == nil then compact = self.Compact end
	for _, name in ipairs(self.Order) do
		local it = self.Items[name]
		if not it.Hidden and it.value ~= nil then
			local function d(v) return (v >= 0 and "+" or "-") .. itemFmt(it, abs(v)) end
			local gain = it.value - (it.start or it.value)
			local val
			if compact then
				val = "**" .. itemFmt(it, it.value) .. "**" .. (gain ~= 0 and (" (" .. d(gain) .. ")") or "")
			else
				local lines = { "**" .. itemFmt(it, it.value) .. "**" }
				if it.reported then
					lines[#lines + 1] = Format.Trend(it.value - it.reported, function(v) return itemFmt(it, v) end)
				end
				lines[#lines + 1] = fmt("`%s/hr` · session `%s`", d(self:Rate(name)), d(gain))
				val = concat(lines, "\n")
			end
			e:Field((it.Icon and (it.Icon .. " ") or "") .. name, val, true)
			it.reported = it.value
		end
	end
	return e
end

function Stats:_charts(o)
	local spec = o.Chart or o.Charts
	if not spec then return {} end
	if spec == true then spec = { self.Order[1] } end
	if type(spec) == "string" or getmetatable(spec) == Chart then spec = { spec } end
	local out = {}
	for _, s in ipairs(spec) do
		local ch
		if type(s) == "string" then
			ch = self:Chart(s, { Type = o.ChartType, Mode = o.ChartMode, Per = o.Per, Theme = o.Theme, Width = o.ChartWidth, Height = o.ChartHeight })
		elseif getmetatable(s) == Chart then
			ch = s
		elseif type(s) == "table" then
			ch = self:Chart(s.Stats or s[1], s)
		end
		if ch then out[#out + 1] = ch end
	end
	return out
end

-- builds the report: returns a list of embeds (extra charts become a gallery)
function Stats:Build(o)
	o = o or {}
	local e = self:Embed(o)
	local embeds = { e }
	local charts = self:_charts(o)
	if #charts == 1 then
		e:Chart(charts[1])
	elseif #charts > 1 then
		local url = "https://www.roblox.com/#hook" .. tostring(floor(clock() * 1000))
		e:Url(url):Chart(charts[1])
		for i = 2, min(#charts, 4) do embeds[#embeds + 1] = newEmbed(nil):Url(url):Chart(charts[i]) end
	end
	return embeds
end

function Stats:Report(o)
	o = o or {}
	return self._c:Send(self:Build(o), o)
end
function Stats:Auto(seconds, o)
	if self._auto then self._auto.Stop() end
	self._auto = self._c:Every(seconds, function() self:Report(o) end)
	return self._auto
end
function Stats:Live(seconds, o)
	if self._live then self._live.Stop() end
	self._live = self._c:Live(seconds, function() return self:Build(o), o end)
	return self._live
end

